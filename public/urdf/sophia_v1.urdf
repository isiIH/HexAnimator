      </geometry>
      <origin rpy="0 0 0" xyz="0.0175 0.0 0.0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.035 0.042 0.045"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.0175 0.0 0.0"/>
    </collision>
  </link>
  <link name="rf_femur_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.0225 0.0 0.0"/>
      <mass value="0.1"/>
      <inertia ixx="6.616666666666667e-06" ixy="0.0" ixz="0.0" iyy="2.2083333333333333e-05" iyz="0.0" izz="1.828333333333333e-05"/>
    </inertial>
    <visual>
