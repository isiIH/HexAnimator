<?xml version="1.0" ?>
<robot name="sophia_hexapod">
  <!-- N·m: Coulomb friction prevents perturbation-driven creep -->
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.5 0.0 1.0"/>
  </material>
  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0005343749999999999" ixy="0.0" ixz="0.0" iyy="0.0005343749999999999" iyz="0.0" izz="0.0009"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.045" radius="0.06"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.045" radius="0.06"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
    </collision>
  </link>
  <link name="rf_coxa_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.0175 0.0 0.0"/>
      <mass value="0.05"/>
      <inertia ixx="1.5787499999999997e-05" ixy="0.0" ixz="0.0" iyy="1.2454166666666668e-05" iyz="0.0" izz="1.3541666666666668e-05"/>
    </inertial>
    <visual>
