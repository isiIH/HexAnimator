    <child link="rf_base_motor_link"/>
  </joint>
  <link name="rf_base_motor_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="rf_coxa_joint" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="5.0" lower="-1.0" upper="1.0" velocity="12"/>
    <parent link="rf_base_motor_link"/>
    <child link="rf_coxa_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <dynamics damping="0.3" friction="0.1"/>
  </joint>
  <joint name="rf_coxa_link_to_rf_femur_link" type="revolute">
    <axis xyz="0 1 0"/>
    <!-- lower=-1.85: swing apex analysis shows -1.796 rad needed at max diagonal speed. -->
    <!-- Was -1.77 rad (-101.4°); joint was hitting stop during diagonal walks.          -->
    <limit effort="5.0" lower="-1.85" upper="1.57" velocity="12"/>
    <parent link="rf_coxa_link"/>
    <child link="rf_femur_link"/>
    <origin rpy="0 0 0" xyz="0.035 0 0"/>
    <dynamics damping="0.3" friction="0.1"/>
  </joint>
  <joint name="rf_femur_link_to_rf_tibia_link" type="revolute">
    <axis xyz="0 1 0"/>
    <!-- upper=2.75 rad (157.6°): kinematic analysis shows max SWING APEX needs 2.667 rad. -->
    <!-- Was 2.0 rad (114°): violated on EVERY step. Fixed to 2.5 still violated at apex. -->
    <!-- 2.75 gives 5° margin above worst-case swing apex (2.667 rad for lm/lb legs).    -->
    <limit effort="5.0" lower="-2.0" upper="2.75" velocity="12"/>
    <parent link="rf_femur_link"/>
    <child link="rf_tibia_link"/>
    <origin rpy="0 0 0" xyz="0.045 0 0"/>
