  <link name="rf_tibia_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.041249999999999995 0.0 0.0"/>
      <mass value="0.08"/>
      <inertia ixx="1.6666666666666669e-06" ixy="0.0" ixz="0.0" iyy="5.416666666666667e-05" iyz="0.0" izz="5.55e-05"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.08249999999999999 0.005 0.015"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.041249999999999995 0.0 0.0"/>
      <material name="black"/>
    </visual>
    <visual>
      <geometry>
        <sphere radius="0.0075"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.08249999999999999 0.0 0.0"/>
      <material name="black"/>
    </visual>
    <!-- tibia_body_collision (box) REMOVED: caused spurious asymmetric contacts
           inducing yaw torque. Only the sphere at the tip makes ground contact.  -->
    <!-- SOLE contact point: sphere at the foot tip -->
    <collision>
      <geometry>
        <sphere radius="0.0075"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.08249999999999999 0.0 0.0"/>
    </collision>
  </link>
  <joint name="rf_fixed_base_joint" type="fixed">
    <origin rpy="0 0 1.0471975511965976" xyz="0.030000000000000006 0.05196152422706631 0.0"/>
